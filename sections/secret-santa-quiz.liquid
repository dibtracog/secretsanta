{%- liquid
  if section.settings.collection != blank
    assign quiz_products = section.settings.collection.products
  else
    assign quiz_products = collections.all.products
  endif

  assign b1 = section.settings.budget_1 | times: 100
  assign b2 = section.settings.budget_2 | times: 100
  assign b3 = section.settings.budget_3 | times: 100
  assign b4 = section.settings.budget_4 | times: 100
-%}

{%- capture label_0 -%}Under {{ b1 | money_without_trailing_zeros | strip_html }}{%- endcapture -%}
{%- capture label_1 -%}{{ b1 | money_without_trailing_zeros | strip_html }}–{{ b2 | money_without_trailing_zeros | strip_html }}{%- endcapture -%}
{%- capture label_2 -%}{{ b2 | money_without_trailing_zeros | strip_html }}–{{ b3 | money_without_trailing_zeros | strip_html }}{%- endcapture -%}
{%- capture label_3 -%}{{ b3 | money_without_trailing_zeros | strip_html }}–{{ b4 | money_without_trailing_zeros | strip_html }}{%- endcapture -%}
{%- capture label_4 -%}Above {{ b4 | money_without_trailing_zeros | strip_html }}{%- endcapture -%}

<section id="secret-santa-quiz" class="section section-surface section-garland" data-ss-root>
  <div class="container">
    <div class="section-heading center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="ss-card ss-quiz" data-ss-quiz>
      <img class="ss-holly" src="{{ 'deco-holly.svg' | asset_url }}" alt="" width="220" height="160" aria-hidden="true">
      <div class="ss-progress" aria-hidden="true"><div class="ss-progress-bar" data-ss-progress></div></div>
      <p class="ss-step-count" data-ss-step-count aria-live="polite"></p>

      <form data-ss-form novalidate>
        <fieldset class="ss-step" data-ss-step>
          <legend tabindex="-1">Who's your Secret Santa?</legend>
          <p class="ss-hint">Give them a name (or a nickname only you'd get) and tell us how you know them.</p>
          <div class="field ss-name">
            <label for="ss-name-{{ section.id }}" class="visually-hidden">Their name or nickname</label>
            <input id="ss-name-{{ section.id }}" type="text" name="name" maxlength="40" placeholder="Their name or nickname (optional)" autocomplete="off">
          </div>
          <div class="ss-options">
            {%- assign relationships = 'Friend,Colleague,Partner,Sibling,Boss,Family' | split: ',' -%}
            {%- assign rel_emojis = '🫶,💼,💘,👯,🧑‍💼,🏡' | split: ',' -%}
            {%- for rel in relationships -%}
              <label class="ss-option">
                <input type="radio" name="relationship" value="{{ rel }}" required>
                <span><em>{{ rel_emojis[forloop.index0] }}</em>{{ rel }}</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="ss-step" data-ss-step data-min="1" data-max="3" hidden>
          <legend tabindex="-1">Pick up to 3 words that sound like them</legend>
          <p class="ss-hint">Go with your gut. The first words that pop into your head are usually right.</p>
          <div class="ss-options">
            <label class="ss-option"><input type="checkbox" name="traits" value="mischief"><span><em>😈</em>Prankster</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="cuddle"><span><em>🤗</em>Big hugger</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="adventure"><span><em>🧭</em>Explorer</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="sunshine"><span><em>😁</em>Always smiling</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="sleepy"><span><em>😴</em>Nap champion</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="social"><span><em>🥳</em>Life of the party</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="dreamer"><span><em>🌙</em>Daydreamer</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="perfectionist"><span><em>🗂️</em>Super organised</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="foodie"><span><em>🍕</em>Snack lover</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="drama"><span><em>🎭</em>Dramatic</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="cuddle,sleepy"><span><em>🥺</em>Shy &amp; sweet</span></label>
            <label class="ss-option"><input type="checkbox" name="traits" value="mischief,drama"><span><em>😏</em>Sarcastic &amp; witty</span></label>
          </div>
        </fieldset>

        <fieldset class="ss-step" data-ss-step data-autoadvance hidden>
          <legend tabindex="-1">It's Friday evening. Where are they?</legend>
          <p class="ss-hint">Pick the one that sounds most like them.</p>
          <div class="ss-options ss-options-wide">
            <label class="ss-option"><input type="radio" name="scene" value="social" required><span><em>🎉</em>Organising the team outing</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="sleepy" required><span><em>🛌</em>Already in pyjamas, half asleep</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="foodie" required><span><em>🍜</em>Trying the new food stall in town</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="adventure" required><span><em>🏔️</em>Planning a spontaneous trip</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="mischief" required><span><em>🙈</em>Pulling a prank on someone</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="dreamer" required><span><em>🎬</em>Comfort movie under fairy lights</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="perfectionist" required><span><em>✅</em>Finishing tomorrow's to-do list</span></label>
            <label class="ss-option"><input type="radio" name="scene" value="drama" required><span><em>📣</em>Telling a story with way too much drama</span></label>
          </div>
        </fieldset>

        <fieldset class="ss-step" data-ss-step data-autoadvance hidden>
          <legend tabindex="-1">Where will this gift live?</legend>
          <p class="ss-hint">This helps us pick the right size and style.</p>
          <div class="ss-options ss-options-wide">
            <label class="ss-option"><input type="radio" name="use" value="desk" required><span><em>🖥️</em>On their desk, cheering them up</span></label>
            <label class="ss-option"><input type="radio" name="use" value="bedtime" required><span><em>🌙</em>In bed, as a super-soft hug buddy</span></label>
            <label class="ss-option"><input type="radio" name="use" value="keepsake" required><span><em>🎄</em>On a shelf as a festive keepsake</span></label>
            <label class="ss-option"><input type="radio" name="use" value="nostalgia" required><span><em>📺</em>Anywhere. They love a nostalgic character</span></label>
          </div>
        </fieldset>

        <fieldset class="ss-step" data-ss-step hidden>
          <legend tabindex="-1">What's your budget?</legend>
          <p class="ss-hint">You can change this later on the results screen.</p>
          <div class="ss-options">
            <label class="ss-option"><input type="radio" name="budget" value="0" required><span>{{ label_0 }}</span></label>
            <label class="ss-option"><input type="radio" name="budget" value="1" required><span>{{ label_1 }}</span></label>
            <label class="ss-option"><input type="radio" name="budget" value="2" required checked><span>{{ label_2 }}</span></label>
            <label class="ss-option"><input type="radio" name="budget" value="3" required><span>{{ label_3 }}</span></label>
            <label class="ss-option"><input type="radio" name="budget" value="4" required><span>{{ label_4 }}</span></label>
          </div>
        </fieldset>

        <div class="ss-nav">
          <button type="button" class="button button-ghost" data-ss-back hidden>Back</button>
          <button type="button" class="button" data-ss-next data-next-label="Next" data-finish-label="Find their match 🎁" disabled>Next</button>
        </div>
      </form>
      <p class="ss-privacy">{% render 'icon', name: 'lock' %} Your answers stay in your browser. We never save them.</p>
    </div>

    <div class="ss-results" data-ss-results hidden>
      <div class="ss-card ss-reveal">
        <span class="eyebrow">Personality decoded</span>
        <h3 data-ss-headline></h3>
        <p data-ss-subline></p>
        <div class="ss-traits" data-ss-traits></div>
        <p class="ss-disclaimer">Just for fun! These scores are playful takes on your answers, not science.</p>
      </div>

      <div class="ss-toolbar">
        <h3>Their plush twins</h3>
        <div class="ss-budget-switch" data-ss-budget-switch role="group" aria-label="Budget"></div>
      </div>
      <p class="ss-budget-note" data-ss-budget-note hidden>
        Nothing sits exactly in this budget right now, so here are the closest matches.
      </p>
      <div class="ss-matches" data-ss-matches aria-live="polite"></div>

      <div class="ss-actions">
        <button type="button" class="button button-ghost" data-ss-another>🔄 Show me different picks</button>
        {%- if section.settings.show_card -%}
          <button type="button" class="button button-secondary" data-ss-card>🖼️ Download reveal card</button>
        {%- endif -%}
        <a class="button button-ghost" data-ss-whatsapp href="#" target="_blank" rel="noopener">💬 Share on WhatsApp</a>
        <button type="button" class="button button-ghost" data-ss-restart>🎅 Match another person</button>
      </div>
    </div>
  </div>

  <script type="application/json" data-ss-config>
    {
      "shopName": {{ shop.name | json }},
      "budgets": [
        { "id": 0, "min": 0, "max": {{ b1 }}, "label": {{ label_0 | json }} },
        { "id": 1, "min": {{ b1 }}, "max": {{ b2 }}, "label": {{ label_1 | json }} },
        { "id": 2, "min": {{ b2 | plus: 1 }}, "max": {{ b3 }}, "label": {{ label_2 | json }} },
        { "id": 3, "min": {{ b3 | plus: 1 }}, "max": {{ b4 }}, "label": {{ label_3 | json }} },
        { "id": 4, "min": {{ b4 | plus: 1 }}, "max": null, "label": {{ label_4 | json }} }
      ]
    }
  </script>

  <script type="application/json" data-ss-products>
    [
      {%- assign sep = '' -%}
      {%- for product in quiz_products limit: 50 -%}
        {%- unless product.tags contains 'gift-wrap' -%}
          {{ sep }}{
            "id": {{ product.selected_or_first_available_variant.id | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ product.price | json }},
            "compare": {{ product.compare_at_price | default: 0 | json }},
            "priceLabel": {{ product.price | money | strip_html | json }},
            "compareLabel": {{ product.compare_at_price | default: 0 | money | strip_html | json }},
            "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %},
            "tags": {{ product.tags | json }},
            "available": {{ product.available | json }}
          }
          {%- assign sep = ',' -%}
        {%- endunless -%}
      {%- endfor -%}
    ]
  </script>
  <script src="{{ 'secret-santa.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Secret Santa matchmaker",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Personal gift concierge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell Santa about your person"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Five quick questions, about 60 seconds. We'll match them with a plush twin that fits their personality and your budget."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products to match from",
      "info": "Leave empty to use all products. Tag products with vibe-mischief, vibe-cuddle, gift-desk etc. for better matches."
    },
    {
      "type": "header",
      "content": "Budget bands (store currency)"
    },
    {
      "type": "number",
      "id": "budget_1",
      "label": "Band 1 up to",
      "default": 100
    },
    {
      "type": "number",
      "id": "budget_2",
      "label": "Band 2 up to",
      "default": 150
    },
    {
      "type": "number",
      "id": "budget_3",
      "label": "Band 3 up to",
      "default": 200
    },
    {
      "type": "number",
      "id": "budget_4",
      "label": "Band 4 up to",
      "default": 300
    },
    {
      "type": "checkbox",
      "id": "show_card",
      "label": "Show downloadable reveal card",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Secret Santa matchmaker"
    }
  ]
}
{% endschema %}

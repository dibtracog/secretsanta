<section class="container">
  <div class="collection-header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <span>{{ 'collections.count' | t: count: collection.products_count }}</span>
      <label>
        <span class="visually-hidden">{{ 'collections.sort_by' | t }}</span>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select onchange="var u=new URL(location.href);u.searchParams.set('sort_by',this.value);u.searchParams.delete('page');location.href=u.toString();">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid cols-4">
        {%- for product in collection.products -%}
          {%- unless product.tags contains 'gift-wrap' -%}
            {% render 'product-card', product: product %}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
  <div class="section"></div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}

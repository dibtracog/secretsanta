<section class="section{% if section.settings.surface %} section-surface{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading center">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          <span class="trust-icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Use soft background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gift",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "lock", "label": "Lock" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Badge title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}

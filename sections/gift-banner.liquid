<section class="gift-banner">
  <div class="container">
    <div class="gift-banner-card">
      <div class="gift-banner-art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 320px, 70vw' }}
        {%- else -%}
          <img src="{{ 'art-gift-box.svg' | asset_url }}" alt="" width="360" height="360" loading="lazy">
        {%- endif -%}
      </div>
      <div class="gift-banner-copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {% render 'icon', name: 'gift' %} {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift wrap banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the illustrated gift box."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Secret Santa delivery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wrapped, tagged and delivered in secret"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Add festive gift wrap and a handwritten card, pick a Christmas delivery date, and stay completely anonymous. The only thing they'll know is that someone thought of them."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop gifts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Gift wrap banner"
    }
  ]
}
{% endschema %}

{%- liquid
  if section.settings.collection != blank
    assign featured = section.settings.collection
  else
    assign featured = collections.all
  endif
-%}
<section class="section{% if section.settings.surface %} section-surface{% endif %}">
  <div class="container">
    <div class="section-heading-row">
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and featured.products_count > 0 -%}
        <a class="link-arrow" href="{{ featured.url }}">{{ 'general.view_all' | t }} ({{ featured.products_count }}) →</a>
      {%- endif -%}
    </div>

    <div class="product-grid cols-4">
      {%- if featured.products_count > 0 -%}
        {%- for product in featured.products limit: section.settings.products_to_show -%}
          {%- unless product.tags contains 'gift-wrap' -%}
            {% render 'product-card', product: product %}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card">
            <div class="product-card-media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="product-card-body"><h3 class="product-card-title">Gift idea</h3></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Festive picks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Christmas specials"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cuddly favourites, ready for a Christmas morning surprise."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Use soft background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}

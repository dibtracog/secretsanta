<article class="container article">
  {%- if article.image -%}
    {{ article.image | image_url: width: 1400 | image_tag: class: 'article-img' }}
  {%- endif -%}
  <h1>{{ article.title }}</h1>
  <p><small>{{ article.published_at | time_tag: format: 'date' }}</small></p>
  <div class="rte">{{ article.content }}</div>
  <p><a href="{{ blog.url }}">&larr; {{ blog.title }}</a></p>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}

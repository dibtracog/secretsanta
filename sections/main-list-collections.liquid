<section class="container section">
  <h1>{{ 'collections.all' | t }}</h1>
  <div class="product-grid cols-4">
    {%- for collection in collections -%}
      <div class="product-card">
        <a href="{{ collection.url }}" class="product-card-media" tabindex="-1" aria-hidden="true">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </a>
        <div class="product-card-body">
          <h2 class="product-card-title"><a href="{{ collection.url }}">{{ collection.title }}</a></h2>
          <p class="cart-small">{{ 'collections.count' | t: count: collection.products_count }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}

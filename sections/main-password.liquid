<section class="container password-page">
  <h1>{{ shop.name }}</h1>
  <h2>{{ 'password.coming_soon' | t }}</h2>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}

  <h3>{{ 'password.notify' | t }}</h3>
  {%- form 'customer', class: 'inline-form' -%}
    {%- if form.posted_successfully? -%}
      <p>{{ 'password.thanks' | t }}</p>
    {%- else -%}
      {{ form.errors | default_errors }}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <input type="email" name="contact[email]" required placeholder="{{ 'password.email' | t }}" aria-label="{{ 'password.email' | t }}">
      <button type="submit" class="button">{{ 'password.subscribe' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <details class="password-login">
    <summary>{{ 'password.enter_password' | t }}</summary>
    {%- form 'storefront_password', class: 'inline-form' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
      <button type="submit" class="button">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}

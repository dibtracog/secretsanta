<section class="santa-hero">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'santa-hero-img', loading: 'eager', alt: '' }}
  {%- endif -%}

  <div class="container santa-hero-inner">
    <div>
      {%- if section.settings.badge != blank -%}
        <span class="hero-badge">{% render 'icon', name: 'sparkles' %} {{ section.settings.badge | escape }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.tagline != blank -%}
        <p class="hero-tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="hero-buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: '#secret-santa-quiz' }}">
            {% render 'icon', name: 'gift' %}
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="button button-outline-light" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_countdown -%}
      <div class="countdown-card" data-countdown="{{ settings.christmas_date | strip }}T00:00:00{{ settings.timezone_offset | strip }}">
        <p class="countdown-label">{{ section.settings.countdown_label | escape }}</p>
        <div class="countdown-grid" data-countdown-grid>
          <div class="countdown-unit"><strong data-days>--</strong><span>Days</span></div>
          <div class="countdown-unit"><strong data-hours>--</strong><span>Hours</span></div>
          <div class="countdown-unit"><strong data-minutes>--</strong><span>Mins</span></div>
          <div class="countdown-unit"><strong data-seconds>--</strong><span>Secs</span></div>
        </div>
        <p class="countdown-done" data-countdown-done hidden>🎄 Merry Christmas!</p>
        {%- if section.settings.countdown_note != blank -%}
          <p class="countdown-note">{{ section.settings.countdown_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Christmas hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (optional)"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Christmas specials 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Santa's little secret: find their perfect match"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Describe your Secret Santa. We'll find their softest match."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Not sure what to get? Answer five fun questions and we'll decode their personality, pair them with their plush twin, and have it delivered in time for Christmas."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Start the matchmaker"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Primary button link",
      "default": "#secret-santa-quiz"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Shop all gifts"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show Christmas countdown",
      "info": "Date is set in Theme settings → Christmas.",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Countdown to Christmas Day"
    },
    {
      "type": "text",
      "id": "countdown_note",
      "label": "Countdown note",
      "default": "Pre-book a Dec 20–25 delivery slot with discreet Secret Santa packaging."
    }
  ],
  "presets": [
    {
      "name": "Christmas hero"
    }
  ]
}
{% endschema %}

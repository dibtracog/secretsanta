<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">🧸 {{ shop.name }}</p>
        {%- if section.settings.about != blank -%}
          <p>{{ section.settings.about | escape }}</p>
        {%- endif -%}
        {%- if section.settings.email != blank or section.settings.phone != blank -%}
          <ul class="footer-links">
            {%- if section.settings.phone != blank -%}
              <li><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone | escape }}</a></li>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.menu_1 != blank -%}
        <div>
          <h3>{{ section.settings.menu_1.title }}</h3>
          <ul class="footer-links">
            {%- for link in section.settings.menu_1.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_2 != blank -%}
        <div>
          <h3>{{ section.settings.menu_2.title }}</h3>
          <ul class="footer-links">
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.bottom_text != blank -%}
        <span>{{ section.settings.bottom_text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Soft toys and plushies picked to make every Secret Santa reveal unforgettable."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "First menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Second menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom line text",
      "default": "Made with 🎄 for Secret Santas everywhere"
    }
  ]
}
{% endschema %}

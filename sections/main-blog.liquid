<section class="container section">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 6 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="article-list">
        {%- for article in blog.articles -%}
          <article class="article-card">
            {%- if article.image -%}
              <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
              </a>
            {%- endif -%}
            <div class="article-card-body">
              <p class="cart-small">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
              <a href="{{ article.url }}" class="link-arrow">{{ 'blog.read_more' | t }} →</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'blog.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}

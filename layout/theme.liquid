<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'theme-head' %}
    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
    {% section 'header' %}
    <main id="main" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}

    {%- if settings.show_whatsapp and settings.whatsapp_number != blank -%}
      {%- assign wa_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
      <a
        class="whatsapp-float"
        href="https://wa.me/{{ wa_digits }}?text={{ settings.whatsapp_message | url_encode }}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'general.whatsapp' | t }}"
      >
        {% render 'icon', name: 'chat' %}
        <span>{{ 'general.whatsapp' | t }}</span>
      </a>
    {%- endif -%}

    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
  </body>
</html>

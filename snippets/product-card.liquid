{%- comment -%}
  Product card with quick add.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
<div class="product-card">
  <a href="{{ product.url }}" class="product-card-media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="badge badge-dark">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      {%- assign save = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="badge">{{ 'products.save' | t: percent: save }}</span>
    {%- endif -%}
    {%- if product.tags contains 'bestseller' -%}
      <span class="badge badge-gold">{{ 'products.bestseller' | t }}</span>
    {%- endif -%}
  </a>

  <div class="product-card-body">
    <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="price">
      {{ product.price | money }}
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </p>

    {%- if product.available -%}
      {%- if product.has_only_default_variant -%}
        {%- form 'product', product, data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" class="button button-full">{{ 'products.add_to_cart' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ product.url }}" class="button button-ghost button-full">{{ 'products.choose_options' | t }}</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
